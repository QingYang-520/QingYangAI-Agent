<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="青阳AI.AgreementPage"
             Title="用户协议与隐私政策">
    <Grid Padding="20,16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">

        <!-- 顶部：标题 + 版本号 -->
        <VerticalStackLayout Grid.Row="0" Spacing="3">
            <Label x:Name="lblHeader" Text="欢迎使用青阳AI" FontSize="22"
                   HorizontalOptions="Center" TextColor="White"/>
            <Label x:Name="lblVersion" Text="" FontSize="12"
                   HorizontalOptions="Center" TextColor="#9E8D8C"/>
        </VerticalStackLayout>

        <BoxView Grid.Row="1" HeightRequest="1" Color="#2F2928"/>

        <!-- 正文：由 MarkdownRenderer 在代码里动态填充（见 ApplyMode） -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout x:Name="agreementBody" Spacing="9" Padding="0,4,0,16"/>
        </ScrollView>

        <!-- 底部同意栏：只读模式会被整块隐藏 -->
        <VerticalStackLayout Grid.Row="3" x:Name="consentBar" Spacing="10">
            <HorizontalStackLayout Spacing="8">
                <CheckBox x:Name="chkAgree" Color="#FBB5B2"/>
                <Label Text="我已经阅读并同意以上全部条款" VerticalOptions="Center"
                       TextColor="#E9E1E0" FontSize="14"/>
            </HorizontalStackLayout>
            <Button x:Name="btnConfirm" Text="同意并继续" Clicked="OnAgreeClicked"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
