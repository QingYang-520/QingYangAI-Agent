<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:青阳AI"
             x:Class="青阳AI.ChatPage"
             Title="青阳AI">
    <!-- 常驻统计：本次 usage / 全局累计，数据源 UsageStats.Current -->

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#16161E" Offset="0.0"/>
            <GradientStop Color="#1A1A26" Offset="0.5"/>
            <GradientStop Color="#141420" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <!-- Ta 的隐藏浏览器：给 AI 当"手"用（跑 JS / 点按钮 / 填表单 / 翻页）。
             2×2 塞在最底层、被标题栏盖住 —— 用户看不见也点不到；
             但必须在可视树里、尺寸非 0，Android WebView 才拿得到 handler 和渲染上下文。 -->
        <WebView x:Name="agentWeb"
                 WidthRequest="2" HeightRequest="2"
                 Opacity="0.01"
                 InputTransparent="True"
                 HorizontalOptions="Start" VerticalOptions="Start"/>

        <!-- 消息列表（启动时隐藏，等历史加载完定位到底部后再显示）：
             玻璃档位下铺满全屏（内容从三根玻璃栏下穿过，被模糊垫层虚化）；关闭档由代码动态加避让边距 -->
<CollectionView x:Name="msgList" Margin="0,0,0,76"
                    IsVisible="False"
                    ItemsSource="{Binding Messages}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10,8">

                <!-- AI气泡 靠左 + 尖角，宽度随内容自适应 -->
                <Grid HorizontalOptions="Start"
                      IsVisible="{Binding IsAI}"
                      MaximumWidthRequest="300">
                    <Border BackgroundColor="#2F2928"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            Padding="16,12"
                            Margin="10,4">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Opacity="0.28" Radius="16" Offset="0,4"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <PointerGestureRecognizer PointerPressed="OnMsgPointerPressed" PointerReleased="OnMsgPointerReleased"/>
                        </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="8">

                                    <!-- 思考过程折叠区域 -->
                                    <VerticalStackLayout IsVisible="{Binding HasThinking}" Spacing="2">
                                        <!-- 可点击头部：三角 + 状态文字 -->
                                        <Grid ColumnDefinitions="Auto,*" Padding="2,0">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnThinkingHeaderTapped"/>
                                            </Grid.GestureRecognizers>
                                            <local:MorphIcon Icon="{Binding ThinkingArrow}"
                                                             IconColor="#D5C2C1"
                                                             IconSize="14"
                                                             StrokeWidth="2.5"
                                                             VerticalOptions="Center"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding ThinkingStatusText}"
                                                   TextColor="#D5C2C1"
                                                   FontSize="13"
                                                   VerticalOptions="Center"
                                                   Margin="4,0,0,0"/>
                                        </Grid>
                                        <!-- 思考过程完整文本（展开时显示；用普通 Label 保证逐字实时显示，避免流光 shader 干扰渲染） -->
                                        <Label Text="{Binding Thinking}"
                                               TextColor="#D5C2C1"
                                               FontSize="13"
                                               LineBreakMode="WordWrap"
                                               IsVisible="{Binding ThinkingExpanded}"/>
                                    </VerticalStackLayout>

                                    <!-- 内嵌分割线：有思考过程且其后有内容（终端或正文）时显示 -->
                                    <BoxView HeightRequest="1"
                                             Color="#524342"
                                             Margin="0,4"
                                             IsVisible="{Binding ShowThinkingDivider}"/>

                                    <!-- Agent 循环过程区：折叠时一行摘要，展开时一行一步（含 +N/-N） -->
                                    <VerticalStackLayout IsVisible="{Binding HasAgentRun}" Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto" Padding="2,0">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnAgentHeaderTapped"/>
                                            </Grid.GestureRecognizers>
                                            <!-- 标题：运行中流光，结束后静态 -->
                                            <local:ShimmerLabel Grid.Column="0"
                                                   Text="{Binding AgentHeaderText}"
                                                   TextColor="#9FB8D5"
                                                   HighlightColor="#DCEBFF"
                                                   IsActive="{Binding AgentRunning}"
                                                   FontSize="13"
                                                   MaxLines="1"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                        <!-- 步骤明细（展开时可见） -->
                                        <Label Text="{Binding AgentStepsText}"
                                               TextColor="#8FA6C0"
                                               FontSize="12"
                                               LineBreakMode="WordWrap"
                                               IsVisible="{Binding AgentDetailsVisible}"/>
                                    </VerticalStackLayout>

                                    <!-- 等待回应指示器：还没收到任何内容时显示（思考过程或正文，任一到达即隐藏） -->
                                    <HorizontalStackLayout IsVisible="{Binding IsWaiting}" Spacing="8" Margin="0,2,0,2">
                                        <ActivityIndicator IsRunning="True" Color="#FBB5B2"
                                                           HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                                        <Label Text="等待服务器响应…" TextColor="#D5C2C1" FontSize="13" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <!-- 终端头部三行小气泡（纯黑背景，包在正文上方，文字深绿） -->
                                    <Border BackgroundColor="#000000"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="10,6"
                                            IsVisible="{Binding HasTerminalHeader}">
                                        <VerticalStackLayout Spacing="1">
                                            <!-- 最上面单独一行：纯白 >_（字号比正文大2号） -->
                                            <Label Text=">_" 
                                                   TextColor="White" 
                                                   FontAttributes="Bold"
                                                   FontSize="13"/>
                                            <!-- 标题：使用shizuku — 终端 -->
                                            <Label Text="{Binding TerminalTitleLine}"
                                                   TextColor="#2E7D32"
                                                   FontSize="11"/>
                                            <!-- 当前步骤（运行中流光，深绿提升为偏白绿高光） -->
                                            <local:ShimmerLabel Text="{Binding TerminalStepLine}"
                                                   TextColor="#2E7D32"
                                                   HighlightColor="#B8FFC4"
                                                   IsActive="{Binding IsTerminalRunning}"
                                                   FontSize="11"/>
                                            <!-- 输出 -->
                                            <Label Text="{Binding TerminalOutputLine}"
                                                   TextColor="#2E7D32"
                                                   FontSize="11"
                                                   LineBreakMode="WordWrap"/>
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- 正文（普通文本，无流光） -->
                                    <Label Text="{Binding Content}"
                                           TextColor="White"
                                           FontSize="16"
                                           LineBreakMode="WordWrap"/>

                                    <!-- 时间戳 -->
                                    <Label Text="{Binding TimeText}" TextColor="#9E8D8C" FontSize="11"
                                           HorizontalOptions="Start" Margin="0,2,0,0"/>

                                    <!-- 朗读按钮：点击重播该条回复的语音 -->
                                    <HorizontalStackLayout Spacing="4"
                                                           IsVisible="{Binding HasContent}">
                                        <HorizontalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnSpeakTapped"/>
                                        </HorizontalStackLayout.GestureRecognizers>
                                        <local:MorphIcon Icon="Speaker" IconSize="13" IconColor="#D5C2C1" StrokeWidth="2"/>
                                        <Label Text="朗读" TextColor="#D5C2C1" FontSize="12" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <!-- AI 生成的图片框架：预加载 → 完成后填充 -->
                                    <Border IsVisible="{Binding HasImage}"
                                            BackgroundColor="#3A3333"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            Padding="4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnImageFrameTapped"/>
                                        </Border.GestureRecognizers>
                                        <Grid HeightRequest="200">
                                            <!-- 预加载 -->
                                            <ActivityIndicator IsVisible="{Binding IsImageLoading}"
                                                               IsRunning="{Binding IsImageLoading}"
                                                               Color="#FBB5B2"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center"/>
                                            <!-- 失败 -->
                                            <Label Text="图片生成失败"
                                                   TextColor="#F2B8B5"
                                                   FontSize="13"
                                                   IsVisible="{Binding IsImageError}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                            <!-- 完成后的图片 -->
                                            <Image Source="{Binding ImageSource}"
                                                   Aspect="AspectFit"
                                                   IsVisible="{Binding IsImageDone}"
                                                   HorizontalOptions="Fill"
                                                   VerticalOptions="Fill"/>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                            <BoxView WidthRequest="12"
                                     HeightRequest="12"
                                     Rotation="45"
                                     BackgroundColor="#3A3333"
                                     HorizontalOptions="Start"
                                     VerticalOptions="Start"
                                     TranslationX="-8"
                                     TranslationY="14"/>
                        </Grid>

                        <!-- 用户气泡 靠右，无尖角，宽度随内容自适应 -->
                        <Grid HorizontalOptions="End"
                              IsVisible="{Binding IsUser}"
                              MaximumWidthRequest="300">
                            <Border BackgroundColor="#FBB5B2"
                                    StyleId="chatBubble"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="16,12"
                                    Margin="4,10">
                                <Border.Shadow>
                                    <Shadow Brush="#000000" Opacity="0.28" Radius="16" Offset="0,4"/>
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <PointerGestureRecognizer PointerPressed="OnMsgPointerPressed" PointerReleased="OnMsgPointerReleased"/>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="6">
                                    <!-- 用户发送的图片 -->
                                    <Image Source="{Binding ImageSource}"
                                           Aspect="AspectFit"
                                           IsVisible="{Binding HasImage}"
                                           HeightRequest="180"
                                           HorizontalOptions="Fill"/>
                                    <Label Text="{Binding Content}"
                                           TextColor="White"
                                           FontSize="16"
                                           LineBreakMode="WordWrap"/>

                                    <!-- 时间戳 -->
                                    <Label Text="{Binding TimeText}" TextColor="#D0D0E0" FontSize="11"
                                           HorizontalOptions="End" Margin="0,4,0,0"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 空状态：无聊天记录时居中显示随机语句（灰色大字，每次打开应用重新抽取） -->
        <VerticalStackLayout x:Name="emptyState" VerticalOptions="Center" HorizontalOptions="Center"
                             InputTransparent="True" IsVisible="False">
            <Label x:Name="emptyMotto" HorizontalOptions="Center"
                   TextColor="#D5C2C1" FontAttributes="Bold"/>
        </VerticalStackLayout>

        <!-- 顶部标题栏：头像+标题+心情 | 推理+上下文+缓存+菜单+日记+设置 -->
        <Grid x:Name="titleBar" VerticalOptions="Start" ColumnDefinitions="*,Auto" Padding="14,10"
              BackgroundColor="#181211">
            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center" HorizontalOptions="Start">
                <Border x:Name="avatarBorder"
                        WidthRequest="30" HeightRequest="30"
                        StrokeThickness="0" BackgroundColor="#2F2928"
                        StrokeShape="RoundRectangle 15" VerticalOptions="Center">
                    <Image x:Name="imgAvatar" Aspect="AspectFill"/>
                </Border>
                <Label x:Name="lblTitle" Text="青阳AI"
                       FontSize="18" FontAttributes="Bold"
                       TextColor="White" VerticalOptions="Center"/>
                <Label x:Name="lblMood" Text=""
                       FontSize="13" TextColor="#D5C2C1" VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center" HorizontalOptions="End">
                <!-- 权限盾牌：圆形气泡 + 单色盾牌图标，点击展开权限面板 -->
                <Border x:Name="shieldChip" BackgroundColor="#2F2928" StrokeThickness="0"
                        StrokeShape="RoundRectangle 16" WidthRequest="32" HeightRequest="32"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnShieldTapped"/>
                    </Border.GestureRecognizers>
                    <local:MorphIcon x:Name="shieldIcon" Icon="Shield" IconSize="17"
                                     IconColor="#D5C2C1" StrokeWidth="2"
                                     HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <!-- 推理等级 -->
                <Border x:Name="reasonChip" BackgroundColor="#2F2928" StrokeThickness="0"
                        StrokeShape="RoundRectangle 12" Padding="8,4"
                        VerticalOptions="Center" IsVisible="False">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnReasoningChipTapped"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="reasonLbl" Text="思考:关"
                           TextColor="#FBB5B2" FontSize="12" VerticalOptions="Center"/>
                </Border>
                <!-- 上下文（发消息后由 UsageStats 刷新） -->
                <Label x:Name="lblCtx" Text="上下文" FontSize="11"
                       TextColor="#9E8D8C" VerticalOptions="Center"/>
                <!-- 缓存命中率（发消息后由 usage 刷新） -->
                <Label x:Name="lblCacheHit" Text="缓存命中" FontSize="11"
                       TextColor="#9E8D8C" VerticalOptions="Center"/>
                <!-- 日记 -->
                <Border BackgroundColor="Transparent" StrokeThickness="0"
                        Padding="4,2" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDiaryClicked"/>
                    </Border.GestureRecognizers>
                    <local:MorphIcon Icon="Book" IconSize="18"
                                     IconColor="#D5C2C1" StrokeWidth="2"/>
                </Border>
                <!-- 设置 -->
                <Border BackgroundColor="Transparent" StrokeThickness="0"
                        Padding="4,2" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSettingsClicked"/>
                    </Border.GestureRecognizers>
                    <local:MorphIcon Icon="Settings" IconSize="18"
                                     IconColor="#D5C2C1" StrokeWidth="2"/>
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <!-- 权限面板：点盾牌图标弹出（稍大气泡，含互斥单选 + 独立复选） -->
        <Border x:Name="permPanel" IsVisible="False"
                HorizontalOptions="End" VerticalOptions="Start"
                Margin="0,52,12,0"
                BackgroundColor="#20202B" StrokeThickness="1" Stroke="#3A3A4A"
                StrokeShape="RoundRectangle 14" Padding="14,12"
                WidthRequest="266">
            <VerticalStackLayout Spacing="8">
                <Label Text="文件访问权限" FontSize="14" FontAttributes="Bold" TextColor="White"/>
                <Label Text="四选一，下面的可单独勾选" FontSize="11" TextColor="#9E8D8C"/>

                <!-- 上四行：互斥单选 -->
                <VerticalStackLayout x:Name="permSingleGroup" Spacing="6">

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label x:Name="icoReadWs" Text="📄" FontSize="14" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="仅读取工作区文件" TextColor="#D5C2C1" FontSize="13" VerticalOptions="Center"/>
                        <Label x:Name="chkReadWs" Grid.Column="2" Text="○" TextColor="#B388FF" FontSize="14" VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPermLevelTapped" CommandParameter="1"/>
                        </Grid.GestureRecognizers>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label x:Name="icoWriteWs" Text="✏️" FontSize="14" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="仅修改工作区文件" TextColor="#D5C2C1" FontSize="13" VerticalOptions="Center"/>
                        <Label x:Name="chkWriteWs" Grid.Column="2" Text="○" TextColor="#B388FF" FontSize="14" VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPermLevelTapped" CommandParameter="2"/>
                        </Grid.GestureRecognizers>
                    </Grid>

                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="#3A3A4A"/>

                <VerticalStackLayout x:Name="permDiskGroup" Spacing="6">

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Text="💾" FontSize="14" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="读取全盘文件" TextColor="#D5C2C1" FontSize="13" VerticalOptions="Center"/>
                        <Label x:Name="chkReadDisk" Grid.Column="2" Text="○" TextColor="#B388FF" FontSize="14" VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPermLevelTapped" CommandParameter="3"/>
                        </Grid.GestureRecognizers>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Text="🖊" FontSize="14" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="修改全盘文件" TextColor="#D5C2C1" FontSize="13" VerticalOptions="Center"/>
                        <Label x:Name="chkWriteDisk" Grid.Column="2" Text="○" TextColor="#B388FF" FontSize="14" VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPermLevelTapped" CommandParameter="4"/>
                        </Grid.GestureRecognizers>
                    </Grid>

                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="#3A3A4A"/>

                <!-- 下面两个：独立复选 -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Text="🌐" FontSize="14" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="允许 AI 联网（浏览 + 下载文件）" TextColor="#D5C2C1" FontSize="13" VerticalOptions="Center"/>
                    <Label x:Name="chkBrowser" Grid.Column="2" Text="☐" TextColor="#B388FF" FontSize="14" VerticalOptions="Center"/>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPermBrowserTapped"/>
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid x:Name="rowFullAccess" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Text="🔓" FontSize="14" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="完全访问（放开全部限制）" TextColor="#F2B8B5" FontSize="13" VerticalOptions="Center"/>
                    <Label x:Name="chkFullAccess" Grid.Column="2" Text="☐" TextColor="#B388FF" FontSize="14" VerticalOptions="Center"/>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPermFullAccessTapped"/>
                    </Grid.GestureRecognizers>
                </Grid>

                <!-- 系统权限状态条：没授权时高亮提示 + 一键跳转 -->
                <Border x:Name="storageWarnBox" IsVisible="False"
                        BackgroundColor="#3A2626" StrokeThickness="1" Stroke="#7A3B3B"
                        StrokeShape="RoundRectangle 8" Padding="9,7">
                    <VerticalStackLayout Spacing="6">
                        <Label x:Name="lblStorageWarn" Text="" FontSize="11" TextColor="#FFC9C4" LineBreakMode="WordWrap"/>
                        <Border x:Name="btnGrantStorage" BackgroundColor="#B3453F"
                                StrokeThickness="0" StrokeShape="RoundRectangle 6"
                                Padding="10,6" HorizontalOptions="Start">
                            <Label x:Name="lblGrantStorage" Text="去开启「所有文件访问」" FontSize="11.5" TextColor="White"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGrantStorageTapped"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- 导出：把沙盒里的文件搬到公共 Download -->
                <Grid x:Name="rowExport" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Text="📤" FontSize="14" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="导出工作区到 Download" TextColor="#B9D5C4" FontSize="13" VerticalOptions="Center"/>
                    <Label x:Name="chkExport" Grid.Column="2" Text="›" TextColor="#B388FF" FontSize="14" VerticalOptions="Center"/>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnExportWorkspaceTapped"/>
                    </Grid.GestureRecognizers>
                </Grid>

                <Label x:Name="lblPermSummary" Text="" FontSize="11" TextColor="#9E8D8C" LineBreakMode="WordWrap"/>
            </VerticalStackLayout>
        </Border>

        <!-- 输入框区域（胶囊样式：背景全透明，外面透出内容） -->
        <Border x:Name="inputBar" VerticalOptions="End" Margin="12,0,12,14"
                BackgroundColor="Transparent"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 30"
                Padding="10,8">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnInputBarTapped"/>
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                <Border Grid.Column="0"
                        BackgroundColor="#3A3333"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        WidthRequest="40"
                        HeightRequest="40">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVoiceClicked"/>
                    </Border.GestureRecognizers>
                    <local:MorphIcon Icon="Mic" IconSize="20" IconColor="White" StrokeWidth="2" VerticalOptions="Center"/>
                </Border>
                <Border Grid.Column="1"
                        BackgroundColor="#3A3333"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        WidthRequest="40"
                        HeightRequest="40">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnImageClicked"/>
                    </Border.GestureRecognizers>
                    <local:MorphIcon Icon="Image" IconSize="20" IconColor="White" StrokeWidth="2" VerticalOptions="Center"/>
                </Border>
                <Entry x:Name="txtInput"
                       Grid.Column="2"
                       Placeholder="输入消息，回车发送"
                       PlaceholderColor="#9E8D8C"
                       BackgroundColor="Transparent"
                       TextColor="White"
                       ReturnType="Send"
                       Completed="OnInputCompleted"/>
                <Button x:Name="btnSend"
                        Grid.Column="3"
                        Text="发送"
                        StyleId="btnSend"
                        BackgroundColor="#FBB5B2"
                        CornerRadius="20"
                        WidthRequest="64"
                        VerticalOptions="End"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
