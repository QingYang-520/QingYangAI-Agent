<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="青阳AI.DiaryPage"
             Title="Ta的日记"
             BackgroundColor="#181211">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- 顶部标题栏 -->
        <Grid Grid.Row="0" Padding="16,10" BackgroundColor="#181211">
            <Label Text="Ta的日记"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"/>
        </Grid>

        <!-- 相伴天数 -->
        <Label Grid.Row="1" x:Name="lblDays"
               Text="💗 已陪伴 1 天"
               FontSize="13"
               FontAttributes="Bold"
               TextColor="#FBB5B2"
               Margin="16,10,16,0"/>

        <!-- 日记列表：按日期倒序，一天一篇 -->
        <CollectionView Grid.Row="2" x:Name="diaryList" Margin="8,4">
            <CollectionView.EmptyView>
                <Label Text="还没有日记。多陪Ta聊聊，Ta会开始写日记的。"
                       TextColor="#9E8D8C"
                       FontSize="14"
                       HorizontalOptions="Center"
                       Margin="0,80,0,0"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#241E1E"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            Padding="0"
                            Margin="0,5">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Opacity="0.22" Radius="12" Offset="0,3"/>
                        </Border.Shadow>
                        <Grid ColumnDefinitions="4,*">
                            <!-- 左侧彩色竖条 -->
                            <BoxView Grid.Column="0" Color="#FBB5B2"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="6" Padding="14,12">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="📖" FontSize="14"/>
                                    <Label Text="{Binding Date}"
                                           TextColor="#C4B5FD"
                                           FontSize="13"
                                           FontAttributes="Bold"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding Content}"
                                       TextColor="#EDEDED"
                                       FontSize="15"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
