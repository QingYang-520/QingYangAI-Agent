<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="青阳AI.MemoryListPage"
             Title="Ta记住的事"
             BackgroundColor="#181211">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- 顶部标题栏 -->
        <Grid Grid.Row="0" Padding="16,10" BackgroundColor="#181211">
            <Label Text="Ta记住的事"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"/>
        </Grid>

        <Label Grid.Row="1"
               Text="这些是Ta从聊天里自己记下的，删掉后Ta就不记得了。"
               FontSize="12"
               TextColor="#9E8D8C"
               Padding="16,8,16,0"/>

        <!-- 记忆列表：新的在前，每条可单独删除 -->
        <CollectionView Grid.Row="2" x:Name="memoryList" Margin="10,6">
            <CollectionView.EmptyView>
                <Label Text="还没有记忆。多陪Ta聊聊，Ta会开始记住你的。"
                       TextColor="#9E8D8C"
                       FontSize="14"
                       HorizontalOptions="Center"
                       Margin="0,80,0,0"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#241E1E"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            Padding="0"
                            Margin="0,5">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Opacity="0.20" Radius="10" Offset="0,3"/>
                        </Border.Shadow>
                        <Grid ColumnDefinitions="4,*" ColumnSpacing="0">
                            <!-- 左侧紫色竖条 -->
                            <BoxView Grid.Column="0" Color="#FBB5B2"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="5" Padding="14,12">
                                <Label Text="{Binding Content}"
                                       TextColor="#EDEDED"
                                       FontSize="15"
                                       LineBreakMode="WordWrap"/>
                                <Label Text="{Binding CreatedAt, StringFormat='{0:yyyy-MM-dd HH:mm}'}"
                                       TextColor="#9E8D8C"
                                       FontSize="11"/>
                            </VerticalStackLayout>
                            <Button Grid.Column="2"
                                    Text="删"
                                    FontSize="12"
                                    Padding="10,2"
                                    BackgroundColor="Transparent"
                                    TextColor="#F2B8B5"
                                    VerticalOptions="Center"
                                    Clicked="OnDeleteMemoryClicked"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
